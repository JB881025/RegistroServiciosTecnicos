<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/lightGray">

    <!-- Logo -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:contentDescription="Logo JB INGENIERIA"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Panel Principal"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona una opcion"
        android:textSize="16sp"
        android:textColor="@color/gray"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnClientes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clientes"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primary"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnNuevoServicio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nuevo Servicio"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/accent"/>

    <Button
        android:id="@+id/btnHistorial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Historial"
        android:textSize="18sp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="@color/primaryDark"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnCrearTecnico"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Crear Tecnico"
        android:textSize="18sp"
        android:layout_marginBottom="48dp"
        android:backgroundTint="@color/accent"
        android:visibility="gone"/>

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cerrar Sesion"
        android:backgroundTint="@android:color/holo_red_dark"
        android:textSize="14sp"/>

</LinearLayout>